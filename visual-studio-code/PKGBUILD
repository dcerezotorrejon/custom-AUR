# Maintainer: Daniel Cerezo <dcerezotorrejon>
pkgname=visual-studio-code
_pkgname=code
pkgver=1.133.0
pkgrel=1
pkgdesc="Visual Studio Code - Official binary build from Microsoft"
arch=('x86_64')
url="https://code.visualstudio.com/"
license=('custom:freeware')

# --- DEPENDENCIAS CORREGIDAS Y ACTUALIZADAS ---
depends=(
    'alsa-lib'
    'bash'
    'desktop-file-utils'
    'gcc-libs'
    'glib2'
    'glibc'
    'gnupg'
    'gtk3'
    'libnotify'
    'libsecret'
    'libxkbfile'
    'libxss'
    'lsof'
    'nss'
    'shared-mime-info'
    'xdg-utils'
)

optdepends=(
    'git: Integración nativa con control de versiones'
    'kdialog: Selector de archivos nativo para KDE Plasma'
    'libdbusmenu-glib: Menú global integrado en KDE'
    'org.freedesktop.secrets: Sincronización de configuración mediante Keyring'
)

provides=('code' 'visual-studio-code')
conflicts=('code' 'visual-studio-code-bin' 'code-git')

# --- TARBALLS OFICIALES POR ARQUITECTURA ---
source_x86_64=("vscode-${pkgver}-x64.tar.gz::https://update.code.visualstudio.com/${pkgver}/linux-x64/stable")



package() {
    # El tarball se descomprime automáticamente dentro de $srcdir en una carpeta tipo VSCode-linux-x64
    cd "${srcdir}"/VSCode-linux-*

    # 1. Copiar estructura de binarios a /opt/code
    install -d "${pkgdir}/opt/${_pkgname}"
    cp -r . "${pkgdir}/opt/${_pkgname}/"

    # 2. Ajuste de permisos para el sandbox de Electron
    chmod u-s "${pkgdir}/opt/${_pkgname}/chrome-sandbox" 2>/dev/null || true

    # 3. Enlace simbólico principal en /usr/bin
    install -d "${pkgdir}/usr/bin"
    ln -sf "/opt/${_pkgname}/bin/code" "${pkgdir}/usr/bin/code"

    # 4. Crear el archivo .desktop
    install -d "${pkgdir}/usr/share/applications"
    cat <<EOF > "${pkgdir}/usr/share/applications/code-official.desktop"
[Desktop Entry]
Name=Visual Studio Code (Official)
Comment=Code Editing. Redefined.
Exec=/usr/bin/code --unity-launch %F
Icon=code
Type=Application
StartupNotify=false
StartupWMClass=code
Categories=Development;IDE;TextEditor;
MimeType=text/plain;inode/directory;application/x-code-workspace;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/bin/code --new-window %F
Icon=code
EOF

    # 5. Enlace del icono al sistema
    install -d "${pkgdir}/usr/share/pixmaps"
    ln -sf "/opt/${_pkgname}/resources/app/resources/linux/code.png" "${pkgdir}/usr/share/pixmaps/code.png"

    # 6. Licencia
    install -d "${pkgdir}/usr/share/licenses/${pkgname}"
    LICENSE_FILE=$(find . -maxdepth 4 -name "LICENSE.txt" -o -name "LICENSE.rtf" | head -n 1)
    if [ -n "$LICENSE_FILE" ]; then
        install -m644 "$LICENSE_FILE" "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi
}
sha256sums_x86_64=('2bf1a90d2f008af009eb3c4a7bd0849b9247a0588cd39a404a0b1e691be68161')
